BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_DEF_DEF_ "E2E_DataID" 0;
BA_ "BusType" "CAN";
BA_ "GenMsgCycleTime" BO_ 257 20;
BA_ "GenMsgCycleTime" BO_ 258 100;
BA_ "GenMsgCycleTime" BO_ 259 100;
BA_ "GenMsgCycleTime" BO_ 273 100;
BA_ "GenMsgCycleTime" BO_ 516 100;
BA_ "E2E_DataID" BO_ 256 60;
BA_ "E2E_DataID" BO_ 257 90;
BA_ "E2E_DataID" BO_ 258 150;
BA_ "E2E_DataID" BO_ 259 195;
BA_ "E2E_DataID" BO_ 260 105;
BA_ "E2E_DataID" BO_ 261 165;
BA_ "E2E_DataID" BO_ 262 15;
BA_ "E2E_DataID" BO_ 272 240;
BA_ "E2E_DataID" BO_ 273 153;
BA_ "E2E_DataID" BO_ 516 51;

VAL_ 258 Climate_Mode 0 "Manual" 1 "Auto" ;
VAL_ 259 Lock_State 0 "Unlocked" 1 "Locked" ;
VAL_ 259 Alarm_State 0 "Disarmed" 1 "Armed" 2 "Alarm" ;
VAL_ 261 Climate_Mode_Cmd 0 "Manual" 1 "Auto" ;
VAL_ 262 Lock_Cmd 0 "No_Action" 1 "Lock" 2 "Unlock" ;
VAL_ 262 Headlight_Cmd 0 "Auto" 1 "Off" 2 "On" ;
VAL_ 262 CabinLight_Cmd 0 "Auto" 1 "Off" 2 "On" ;
VAL_ 272 Alert_Type 0 "None" 1 "Drowsy" 2 "Distracted" 3 "No_Face" ;
VAL_ 272 Severity 0 "None" 1 "Low" 2 "High" 3 "Critical" ;
